  "maxRecursiveRenderDepth": 4,
  "tableIdColumnName": "ファイル",
  "tableGroupColumnName": "グループ",
  "showResultCount": true,
  "allowHtml": true,
  "inlineQueryPrefix": "=",
  "inlineJsQueryPrefix": "$="
}
